---
// Popup de mise en avant d'un événement (données : src/data/events.ts).
// - Une seule fois par session de navigation.
// - S'ouvre après 10 s, pas dès l'arrivée : Google pénalise sur mobile les
//   fenêtres qui recouvrent le contenu au chargement.
// - Se désactive seul après la date de fin, même sans nouveau déploiement.
import { featuredEvent } from '../data/events';
---

<div
  id="event-popup"
  class="fixed inset-0 z-[9999] flex items-center justify-center p-4 bg-bg-base/75 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300"
  data-end={featuredEvent.endISO}
  aria-hidden="true"
>
  <div
    role="dialog"
    aria-modal="true"
    aria-labelledby="event-popup-title"
    class="event-popup__card relative w-full max-w-md rounded-3xl border border-primary/60 bg-gradient-to-br from-bg-surface to-bg-surface-low px-7 pt-10 pb-8 text-center shadow-[0_0_60px_rgba(53,36,232,0.35),0_0_120px_rgba(199,0,211,0.15)] translate-y-6 scale-[0.97] transition-transform duration-300"
  >
    <button
      type="button"
      data-event-popup-close
      aria-label="Fermer"
      class="absolute top-3 right-3 w-10 h-10 rounded-full flex items-center justify-center text-text-muted hover:text-white transition-colors cursor-pointer"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
    </button>

    <p class="inline-flex items-center gap-2 rounded-full gradient-cta px-4 py-1 font-[family-name:var(--font-label)] text-[11px] font-bold uppercase tracking-[0.14em] text-white">
      {featuredEvent.city} · {featuredEvent.dates}
    </p>

    <h2 id="event-popup-title" class="mt-5 font-[family-name:var(--font-headline)] font-black text-4xl leading-none text-white">
      {featuredEvent.name}
    </h2>

    <p class="mt-4 text-text-secondary leading-relaxed">
      Deux jours à {featuredEvent.city}, les {featuredEvent.dates}.<br />
      Le programme et les inscriptions sont sur la page de l'événement.
    </p>

    <a
      href={featuredEvent.url}
      target="_blank"
      rel="noopener"
      data-event-popup-cta
      class="mt-7 inline-flex items-center gap-2 gradient-cta text-white px-8 py-4 rounded-full font-[family-name:var(--font-headline)] font-bold text-sm uppercase tracking-widest neon-glow-primary hover:scale-105 transition-transform duration-300"
    >
      Voir le programme
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
    </a>
  </div>
</div>

<style>
  #event-popup[data-open] {
    opacity: 1;
    pointer-events: auto;
  }
  #event-popup[data-open] .event-popup__card {
    transform: none;
  }
</style>

<script>
  const SEEN_KEY = 'tfb_event_popup_seen';
  const OPEN_DELAY_MS = 10_000;

  const popup = document.getElementById('event-popup');
  const closeBtn = popup?.querySelector<HTMLButtonElement>('[data-event-popup-close]');

  const alreadySeen = () => {
    try { return sessionStorage.getItem(SEEN_KEY) === '1'; } catch { return false; }
  };
  const markSeen = () => {
    try { sessionStorage.setItem(SEEN_KEY, '1'); } catch { /* stockage indisponible */ }
  };

  if (popup && closeBtn) {
    const ended = Date.now() > new Date(`${popup.dataset.end}T23:59:59`).getTime();

    const close = () => {
      popup.removeAttribute('data-open');
      popup.setAttribute('aria-hidden', 'true');
    };
    const open = () => {
      popup.setAttribute('data-open', '');
      popup.setAttribute('aria-hidden', 'false');
      markSeen();
      closeBtn.focus({ preventScroll: true });
    };

    if (!ended && !alreadySeen()) setTimeout(open, OPEN_DELAY_MS);

    closeBtn.addEventListener('click', close);
    popup.querySelector('[data-event-popup-cta]')?.addEventListener('click', close);
    popup.addEventListener('click', (e) => { if (e.target === popup) close(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
  }
</script>
